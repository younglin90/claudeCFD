FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 0 0);
boundaryField
{
    liquid_inlet
    {
        type fixedValue;
        value uniform (0 1 0);
    }
    inner_nozzle_wall
    {
        type noSlip;
    }
    nozzle_electrode
    {
        type noSlip;
    }
    collector_ground
    {
        type movingWallVelocity;
        value uniform (0 0 0);
    }
    open_atmosphere
    {
        type zeroGradient;
    }
    background
    {
        type zeroGradient;
    }
}

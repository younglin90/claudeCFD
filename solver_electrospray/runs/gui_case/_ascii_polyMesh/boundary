FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    liquid_inlet
    {
        type            patch;
        nFaces          1;
        startFace       0;
    }
    nozzle_electrode
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1;
        startFace       1;
    }
    collector_ground
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1;
        startFace       2;
    }
    open_atmosphere
    {
        type            patch;
        nFaces          3;
        startFace       3;
    }
)

